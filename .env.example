# ═══════════════════════════════════════════════════════════════════════════
# Dark Trace AI — Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Application Environment ───────────────────────────────────────────────
# Options: development, staging, production
ENV=production

# ── Server Port Configuration ─────────────────────────────────────────────
# Port to bind locally. On Render/Cloud Run, this is overridden dynamically by $PORT.
PORT=8000

# ── CORS Security ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * to allow all
# Example: https://darktrace-ai.vercel.app,http://localhost:3000,http://127.0.0.1:8000
ALLOWED_ORIGINS=*

# ── Storage & Model Paths ────────────────────────────────────────────────
# Path to ChromaDB vector store directory (relative or absolute)
CHROMA_DATA_DIR=./chroma_data

# ── Runtime & Hosting Metadata ───────────────────────────────────────────
# Target Python version for cloud builders (Render, etc.)
PYTHON_VERSION=3.10.12

# ── Frontend Backend API URL ─────────────────────────────────────────────
# Used by frontend client or Streamlit app to communicate with FastAPI
API_URL=https://darktrace-api.onrender.com
